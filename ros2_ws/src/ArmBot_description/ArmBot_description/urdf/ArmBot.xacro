<joint name="Revolute 1" type="continuous">
  <origin xyz="0.0 0.0 0.08" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="link_1_1"/>
  <axis xyz="0.0 0.0 1.0"/>
</joint>

