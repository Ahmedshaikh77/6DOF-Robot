<xacro:include filename="$(find ArmBot_description)/urdf/ArmBot.gazebo" />
<link name="base_link">
  <inertial>
    <origin xyz="1.8528073920390487e-17 0.0 0.04" rpy="0 0 0"/>
    <mass value="30.826877913349847"/>
    <inertia ixx="0.136858" iyy="0.136858" izz="0.240835" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ArmBot_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ArmBot_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

